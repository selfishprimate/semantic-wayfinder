#!/bin/sh
# Pre-commit hook for Semantic Wayfinder.
#
# Two responsibilities, both gated on the source-of-truth SKILL.md being staged:
#
# 1. Auto-bump the patch version in SKILL.md frontmatter (unless the user
#    already bumped it manually as part of their edit).
#
# 2. Sync the change to the .agents/ and .gemini/ copies and stage them, so
#    a single commit always carries the three SKILL.md files together.
#
# **Why patch-only auto-bump:** the pre-commit hook runs BEFORE git's
# prepare-commit-msg step, so the commit message isn't yet written to
# .git/COMMIT_EDITMSG. We can't reliably detect "feat:" / "BREAKING:" prefixes
# from a not-yet-written file. Earlier versions of this hook tried to grep
# COMMIT_EDITMSG and silently produced wrong bump types.
#
# For minor or major bumps, manually bump BEFORE staging:
#
#   ./scripts/bump-version.sh minor
#   git add .claude/skills/wayfinder/SKILL.md
#   git commit -m "feat: ..."
#
# The hook detects manual bumps (HEAD vs current frontmatter diff) and skips
# its own auto-bump, so the manual minor/major is preserved.
#
# Activated via `git config core.hooksPath scripts/hooks` — see CONTRIBUTING.md.

set -e

SOURCE=".claude/skills/wayfinder/SKILL.md"

if ! git diff --cached --name-only --diff-filter=ACMR | grep -qx "$SOURCE"; then
  exit 0
fi

echo "[wayfinder] $SOURCE staged — checking version + syncing copies..."

# ─── Version bump (only if not already bumped this commit) ─────────────────

CURRENT=$(grep "^version:" "$SOURCE" | head -1 | sed 's/^version: *//' | tr -d ' ')
HEAD_VERSION=$(git show HEAD:"$SOURCE" 2>/dev/null | grep "^version:" | head -1 | sed 's/^version: *//' | tr -d ' ' || echo "")

if [ -z "$HEAD_VERSION" ] || [ "$CURRENT" = "$HEAD_VERSION" ]; then
  NEW_VERSION=$(./scripts/bump-version.sh patch)
  echo "[wayfinder] version $CURRENT → $NEW_VERSION (patch)"
  echo "[wayfinder]   (for minor/major, run \`./scripts/bump-version.sh minor|major\` BEFORE staging)"
else
  echo "[wayfinder] version already bumped manually: $HEAD_VERSION → $CURRENT"
fi

# ─── Soft warning if CHANGELOG wasn't touched ──────────────────────────────

if ! git diff --cached --name-only --diff-filter=ACMR | grep -qx "CHANGELOG.md"; then
  echo "[wayfinder] ⚠ CHANGELOG.md not staged — consider adding an entry for this change."
fi

# ─── Sync to .agents/ and .gemini/ ─────────────────────────────────────────

./scripts/sync-skills.sh
git add .agents/skills/wayfinder/SKILL.md .gemini/skills/wayfinder/SKILL.md
git add "$SOURCE"   # re-stage in case we bumped the version
./scripts/sync-skills.sh --check

echo "[wayfinder] all three SKILL.md copies in sync."
